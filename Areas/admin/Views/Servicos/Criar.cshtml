@model NailsStudio.Models.ViewModels.ServicoViewModel

<a asp-action="Criar" asp-area="Admin" asp-controller="Servicos">Novo Serviço</a>

<form asp-action="Criar" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div>
        <label asp-for="Nome"></label>
        <input asp-for="Nome" />
        <span asp-validation-for="Nome" class="text-danger"></span>
    </div>
    <div>
        <label asp-for="Descricao"></label>
        <textarea asp-for="Descricao"></textarea>
    </div>
    <div>
        <label asp-for="Preco"></label>
        <input asp-for="Preco" />
        <span asp-validation-for="Preco" class="text-danger"></span>
    </div>
    <div>
        <label asp-for="DuracaoMinutos"></label>
        <input asp-for="DuracaoMinutos" />
        <span asp-validation-for="DuracaoMinutos" class="text-danger"></span>
    </div>

    <button type="submit">Salvar</button>
    <a asp-action="Index">Cancelar</a>
</form>